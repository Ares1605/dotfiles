{
    "$schema": "https://opencode.ai/config.json",
    "permissions": [
        { "action": "*", "resource": "*", "effect": "ask" },
        { "action": "shell", "resource": "*", "effect": "allow" },
        { "action": "webfetch", "resource": "*", "effect": "allow" },
        { "action": "edit", "resource": "*", "effect": "ask" },
        { "action": "glob", "resource": "*", "effect": "allow" },
        { "action": "grep", "resource": "*", "effect": "allow" },
        { "action": "search", "resource": "*", "effect": "allow" },
        { "action": "rg", "resource": "*", "effect": "allow" },
        { "action": "read", "resource": "*", "effect": "allow" },
        { "action": "read_file", "resource": "*", "effect": "allow" },
        { "action": "todowrite", "resource": "*", "effect": "allow" },
        { "action": "execute", "resource": "*", "effect": "ask" },
        { "action": "grafana_*", "resource": "*", "effect": "allow" },
        { "action": "subagent", "resource": "explore", "effect": "allow" }
    ],
    "agents": {
        "investigator": {
            "mode": "primary",
            "system": "{file:./prompts/investigator.txt}",
            "permissions": [
                { "action": "edit", "resource": "*", "effect": "deny" },
                { "action": "shell", "resource": "*", "effect": "allow" }
            ]
        },
        "ask": {
            "mode": "primary",
            "system": "Your job is to answer any questions the user has in a concise and useful manner. Be informational, and format your message cleanly to be easily readable and to the point.",
            "permissions": [
                { "action": "*", "resource": "*", "effect": "deny" }
            ]
        }
    },
    "plugins": [
      "@mohak34/opencode-notifier@latest"
    ],
    "mcp": {
      "servers": {
        "grafana": {
          "type": "remote",
          "url": "https://mcp.grafana.com/mcp/pcointelligence.grafana.net"
        }
      }
    }
}
